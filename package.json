{
  "name": "omnisql-mcp",
  "version": "3.0.0",
  "description": "Database MCP server with direct multi-instance setup, read-only policies, bounded results, and optional DBeaver connection import",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "omnisql-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/native/*.wasm",
    "dist/native/package.json",
    "dist/native/LICENSE",
    "dist/native/THIRD_PARTY_LICENSES.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "clean": "bun -e \"await import('node:fs/promises').then(fs => fs.rm('dist', {recursive:true, force:true}))\"",
    "prepare": "bun scripts/prepare.mjs",
    "watch": "bun --watch src/index.ts",
    "example": "bun examples/example.js",
    "bump": "bumpp",
    "bump:patch": "bumpp patch",
    "bump:minor": "bumpp minor",
    "bump:major": "bumpp major",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "publish": "echo 'Use ./scripts/publish.sh or npm run publish:patch/minor/major instead'",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test",
    "test": "bun test --isolate tests",
    "test:watch": "bun test --isolate --watch tests",
    "test:coverage": "bun test --isolate --coverage tests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "test:package": "bun scripts/check-package.mjs",
    "demo": "bun scripts/demo.mjs",
    "test:integration": "bun run build && bun scripts/integration.mjs",
    "build:rust": "bun scripts/build-rust.mjs",
    "test:rust": "cargo test --locked --manifest-path native/sql-policy/Cargo.toml",
    "test:results": "bun run build && bun scripts/check-results.mjs",
    "test:catalogs": "bun run build && bun scripts/check-catalogs.mjs",
    "test:privacy": "bun run build && bun scripts/check-privacy.mjs",
    "docs:tools": "bun run build && bun scripts/export-tools.mjs",
    "test:tls": "bun run build && bun scripts/check-tls.mjs",
    "test:duckdb": "bun run build && bun scripts/check-duckdb.mjs",
    "test:clickhouse": "bun run build && bun scripts/check-clickhouse.mjs",
    "test:http": "bun run build && bun scripts/check-http-transport.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "sql",
    "claude",
    "anthropic",
    "cursor",
    "ai",
    "postgresql",
    "mysql",
    "oracle",
    "sqlserver",
    "sqlite",
    "mongodb",
    "database-tools",
    "ai-assistant",
    "database-connectivity",
    "universal-database"
  ],
  "author": "Sarthak Jain",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "oracledb": "^6.10.0",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mssql": "^9.1.8",
    "@types/node": "^22",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.11.6",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.5",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.53.0"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0",
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srthkdev/omnisql-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/srthkdev/omnisql-mcp/issues"
  },
  "homepage": "https://github.com/srthkdev/omnisql-mcp#readme",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "docs-site"
  ]
}
