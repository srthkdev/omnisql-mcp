  {
    "name": "export_data",
    "description": "Export query results to various formats (CSV, JSON, etc.)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "description": "The ID or name of the database connection"
        },
        "query": {
          "type": "string",
          "description": "The SQL query to execute for export (SELECT only)"
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json"
          ],
          "description": "Export format (csv or json)",
          "default": "csv"
        },
        "compression": {
          "type": "string",
          "enum": [
            "none",
            "gzip",
            "brotli",
            "zstd"
          ],
          "default": "none",
          "description": "Optional download compression. Compressed exports return a read_export handle; concatenate decoded base64 chunks, then decompress."
        },
        "includeHeaders": {
          "type": "boolean",
          "description": "Include column headers in export",
          "default": true
        },
        "maxRows": {
          "type": "integer",
          "description": "Maximum number of rows to export",
          "default": 10000,
          "minimum": 1
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional database on the same server; reuses saved credentials and settings"
        }
      },
      "required": [
        "connectionId",
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
