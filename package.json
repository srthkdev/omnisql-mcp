{
  "name": "omnisql-mcp",
  "version": "2.2.0",
  "description": "Universal database MCP server with native PostgreSQL, MySQL, SQLite, SQL Server and Oracle support, reusing saved DB client connections",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "omnisql-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/finalize-build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prepare": "node scripts/prepare.mjs",
    "watch": "tsc --watch",
    "example": "node examples/example.js",
    "bump": "bumpp",
    "bump:patch": "bumpp patch",
    "bump:minor": "bumpp minor",
    "bump:major": "bumpp major",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "publish": "echo 'Use ./scripts/publish.sh or npm run publish:patch/minor/major instead'",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build",
    "test:package": "node scripts/check-package.mjs",
    "demo": "node scripts/demo.mjs",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "test:rust": "cargo test --locked --manifest-path native/sql-policy/Cargo.toml"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "sql",
    "claude",
    "anthropic",
    "cursor",
    "ai",
    "postgresql",
    "mysql",
    "oracle",
    "sqlserver",
    "sqlite",
    "mongodb",
    "database-tools",
    "ai-assistant",
    "database-connectivity",
    "universal-database"
  ],
  "author": "Sarthak Jain",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "csv-parser": "^3.0.0",
    "csv-stringify": "^6.4.6",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "oracledb": "^6.10.0",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mssql": "^9.1.8",
    "@types/node": "^20.0.0",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.11.6",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.5",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srthkdev/omnisql-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/srthkdev/omnisql-mcp/issues"
  },
  "homepage": "https://github.com/srthkdev/omnisql-mcp#readme"
}
